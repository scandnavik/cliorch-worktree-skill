{
  "codex": {
    "command": "codex",
    "args": ["exec", "--dangerously-bypass-approvals-and-sandbox", "{task}"],
    "capabilities": ["code_generation", "refactoring", "debugging"]
  },
  "gemini": {
    "command": "gemini",
    "args": ["--approval-mode", "yolo", "-p", "{task}"],
    "capabilities": ["code_generation", "code_review", "refactoring", "analysis"]
  },
  "copilot": {
    "command": "copilot",
    "args": ["{task}"],
    "capabilities": ["code_generation", "code_review"]
  }
}
